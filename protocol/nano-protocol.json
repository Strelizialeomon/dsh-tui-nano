{
  "contract": "dsh-tui-nano/nano-protocol",
  "contractVersion": "1.0.0",
  "protocol": {
    "major": 1,
    "minor": 0
  },
  "namespace": "nano.*",
  "sourceOfTruth": "This file is the single machine-checkable definition of the Nano host protocol. Both the TypeScript bridge and the Rust runtime load it in tests; method tables, limits, error codes, lifecycle edges, event kinds and fixtures are compared against each implementation so neither side can drift silently.",
  "transport": {
    "encoding": "utf-8",
    "framing": "ndjson",
    "primary": {
      "requestFd": 3,
      "responseFd": 4,
      "nonceRequired": false
    },
    "fallback": {
      "requestFd": 0,
      "responseFd": 1,
      "nonceRequired": true,
      "nonceField": "nonce"
    },
    "diagnostics": "stdout and stderr carry diagnostics only; they never carry protocol frames. In fallback mode stdin/stdout carry protocol frames and every frame carries the per-generation nonce."
  },
  "limits": {
    "maxFrameBytes": 33554432,
    "maxPendingRequests": 64,
    "maxAttachmentChunkBytes": 49152,
    "maxSubscriptionQueueBytes": 8388608,
    "maxTotalQueueBytes": 16777216,
    "maxEventFrameBytes": 262144,
    "gracefulShutdownMs": 10000,
    "termGraceMs": 3000,
    "mountLockStaleMs": 30000,
    "maxReplayEvents": 10000,
    "maxSubmitTextBytes": 32768
  },
  "lifecycle": {
    "states": [
      "stopped",
      "starting",
      "handshaking",
      "ready",
      "disconnected",
      "stopping",
      "failed",
      "lost",
      "cleanup-failed"
    ],
    "transitions": [
      [
        "stopped",
        "starting"
      ],
      [
        "starting",
        "handshaking"
      ],
      [
        "handshaking",
        "ready"
      ],
      [
        "starting",
        "stopping"
      ],
      [
        "handshaking",
        "stopping"
      ],
      [
        "starting",
        "failed"
      ],
      [
        "handshaking",
        "failed"
      ],
      [
        "ready",
        "disconnected"
      ],
      [
        "ready",
        "lost"
      ],
      [
        "ready",
        "stopping"
      ],
      [
        "disconnected",
        "lost"
      ],
      [
        "failed",
        "stopping"
      ],
      [
        "lost",
        "stopping"
      ],
      [
        "stopping",
        "stopped"
      ],
      [
        "stopping",
        "cleanup-failed"
      ]
    ]
  },
  "startupErrorCodes": [
    "occupied",
    "startup-failed",
    "cleanup-failed",
    "unsupported"
  ],
  "errorCodes": [
    {
      "code": -32700,
      "name": "jsonrpc/parse-error"
    },
    {
      "code": -32600,
      "name": "jsonrpc/invalid-request"
    },
    {
      "code": -32601,
      "name": "jsonrpc/method-not-found"
    },
    {
      "code": -32602,
      "name": "jsonrpc/invalid-params"
    },
    {
      "code": -32603,
      "name": "jsonrpc/internal-error"
    },
    {
      "code": 1001,
      "name": "nano/not-ready"
    },
    {
      "code": 1002,
      "name": "nano/subscription-unknown"
    },
    {
      "code": 1003,
      "name": "nano/frame-too-large"
    },
    {
      "code": 1004,
      "name": "nano/pending-limit"
    },
    {
      "code": 1005,
      "name": "nano/generation-mismatch"
    },
    {
      "code": 1006,
      "name": "nano/cancelled"
    },
    {
      "code": 1007,
      "name": "nano/cleanup-failed"
    },
    {
      "code": 1008,
      "name": "nano/unsupported"
    },
    {
      "code": 1009,
      "name": "nano/protocol"
    },
    {
      "code": 1010,
      "name": "nano/closed"
    },
    {
      "code": 1011,
      "name": "nano/conversation/address"
    },
    {
      "code": 1012,
      "name": "nano/conversation/empty"
    },
    {
      "code": 1013,
      "name": "nano/conversation/content"
    },
    {
      "code": 1014,
      "name": "nano/conversation/queue-item-not-found"
    },
    {
      "code": 1015,
      "name": "nano/conversation/queued-attachment"
    },
    {
      "code": 1016,
      "name": "nano/conversation/steer-unavailable"
    },
    {
      "code": 1017,
      "name": "nano/conversation/rejected"
    },
    {
      "code": 1018,
      "name": "nano/conversation/too-large"
    },
    {
      "code": 1019,
      "name": "nano/schedule/unavailable"
    },
    {
      "code": 1020,
      "name": "nano/schedule/error"
    }
  ],
  "shapes": {
    "protocolVersion": {
      "major": "integer",
      "minor": "integer"
    },
    "versions": {
      "official": "string",
      "bridge": "string",
      "node": "string"
    },
    "sessionFacts": {
      "mode": "enum:created|resumed",
      "seq": "integer",
      "header": "object?"
    },
    "capability": {
      "status": "enum:supported|unavailable|unsupported",
      "mode": "string?",
      "detail": "string?",
      "required": "boolean?"
    },
    "capabilityMap": {
      "*": "capability"
    },
    "limits": {
      "maxFrameBytes": "integer",
      "maxPendingRequests": "integer",
      "maxAttachmentChunkBytes": "integer"
    },
    "address": {
      "rootSessionId": "string",
      "childSessionId": "string?",
      "parentSessionId": "string?",
      "mode": "string?"
    },
    "hello": {
      "protocol": "protocolVersion",
      "runtimeId": "string",
      "generation": "integer",
      "versions": "versions",
      "cwd": "string",
      "rootSessionId": "string",
      "session": "sessionFacts",
      "capabilities": "capabilityMap",
      "limits": "limits"
    },
    "startupError": {
      "code": "enum:occupied|startup-failed|cleanup-failed|unsupported",
      "holderPid": "integer?",
      "generation": "integer?",
      "message": "string",
      "repairPath": "string?"
    },
    "event": {
      "runtimeId": "string",
      "generation": "integer",
      "subscriptionId": "string",
      "sequence": "integer",
      "kind": "enum:session.event|conversation.status|conversation.inbox|conversation.stream",
      "payload": "object"
    },
    "streamEnded": {
      "runtimeId": "string",
      "generation": "integer",
      "subscriptionId": "string",
      "outcome": "enum:completed|cancelled|failed",
      "reason": "string?"
    },
    "shutdownReport": {
      "steps": "array:shutdownStep",
      "clean": "boolean"
    },
    "shutdownStep": {
      "name": "string",
      "status": "enum:stopped|failed|unknown",
      "detail": "string?"
    },
    "conversationMessage": {
      "id": "string",
      "role": "string",
      "content": "array:object",
      "source": "object",
      "toolCallId": "string?"
    },
    "conversationInbox": {
      "nextTurn": "array:conversationMessage",
      "nextStep": "array:conversationMessage"
    },
    "conversationStreamFrame": {
      "type": "enum:start|chunk|end",
      "attemptId": "string",
      "revision": "integer",
      "turn": "integer?",
      "step": "integer?",
      "index": "integer?",
      "time": "integer?",
      "chunk": "object?",
      "outcome": "object?"
    },
    "conversationSnapshot": {
      "address": "address",
      "seq": "integer",
      "status": "enum:idle|running",
      "inbox": "conversationInbox"
    }
  },
  "methods": [
    {
      "name": "nano.hello",
      "direction": "host-to-client",
      "kind": "notification",
      "owner": "S01",
      "status": "implemented",
      "params": {
        "shape": "hello",
        "required": [
          "protocol",
          "runtimeId",
          "generation",
          "versions",
          "cwd",
          "rootSessionId",
          "session",
          "capabilities",
          "limits"
        ],
        "optional": []
      }
    },
    {
      "name": "nano.startupError",
      "direction": "host-to-client",
      "kind": "notification",
      "owner": "S01",
      "status": "implemented",
      "params": {
        "shape": "startupError",
        "required": [
          "code",
          "message"
        ],
        "optional": [
          "holderPid",
          "generation",
          "repairPath"
        ]
      }
    },
    {
      "name": "nano.shutdown",
      "direction": "client-to-host",
      "kind": "request",
      "owner": "S01",
      "status": "implemented",
      "params": {
        "required": [],
        "optional": [
          "reason"
        ]
      },
      "result": {
        "shape": "shutdownReport",
        "required": [
          "steps",
          "clean"
        ]
      }
    },
    {
