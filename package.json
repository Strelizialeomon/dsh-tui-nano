{
  "name": "dsh-tui-nano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:bridge": "node --test bridge/test/*.test.mjs",
    "test:rust": "cargo test",
    "test:e2e": "NANO_E2E=1 cargo test --test integration -- --test-threads=1",
    "test:host": "NANO_E2E=1 node --test bridge/test/integration/host.test.mjs",
    "test:e2e:slow": "NANO_E2E=1 NANO_E2E_SLOW=1 cargo test --test integration shutdown_budget_is_bounded_when_cleanup_hangs"
  }
}
